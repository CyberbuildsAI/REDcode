{
  "name": "redcode-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "theme:package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && cd extensions/rednode-hud-theme && vsce package --no-dependencies --out ../../dist/",
    "redcode:package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && cd extensions/redcode && vsce package --no-dependencies --out ../../dist/",
    "bridge:build": "npm run build --prefix ../REDbridge",
    "bridge:update": "npm run update --prefix ../REDbridge",
    "mcp:build": "npm run build --workspace packages/redcode-mcp",
    "mcp:start": "node packages/redcode-mcp/dist/server.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
