{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run REDcode",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/redcode"],
      "outFiles": ["${workspaceFolder}/extensions/redcode/dist/**/*.js"],
      "preLaunchTask": "build redcode"
    },
    {
      "name": "Run REDcode (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/redcode",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/rednode-hud-theme",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/extensions/redcode/dist/**/*.js"],
      "preLaunchTask": "build redcode"
    },
    {
      "name": "Run REDcode and REDdeck (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/redcode",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/rednode-hud-theme",
        "--extensionDevelopmentPath=${workspaceFolder}/../REDdeck",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/extensions/redcode/dist/**/*.js", "${workspaceFolder}/../REDdeck/dist/**/*.js"],
      "preLaunchTask": "build redcode"
    }
  ]
}
