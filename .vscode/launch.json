{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run REDcode Core",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/redcode-core"],
      "outFiles": ["${workspaceFolder}/extensions/redcode-core/dist/**/*.js"],
      "preLaunchTask": "build redcode-core"
    },
    {
      "name": "Run REDcode Core (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/redcode-core",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/rednode-hud-theme",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/extensions/redcode-core/dist/**/*.js"],
      "preLaunchTask": "build redcode-core"
    },
    {
      "name": "Run REDcode Core and REDdeck (no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/redcode-core",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/rednode-hud-theme",
        "--extensionDevelopmentPath=${workspaceFolder}/../REDdeck",
        "--disable-extensions"
      ],
      "outFiles": ["${workspaceFolder}/extensions/redcode-core/dist/**/*.js", "${workspaceFolder}/../REDdeck/dist/**/*.js"],
      "preLaunchTask": "build redcode-core"
    }
  ]
}
