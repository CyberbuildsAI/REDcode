{
  "name": "redcode-mcp",
  "version": "0.1.0",
  "description": "REDbridge as an MCP server: Cyberpunk 2077 archives, CR2W files as JSON, textures, hashes, and a document session with patches, for AI assistants such as Claude Code and REDagent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/REDcode",
    "directory": "packages/redcode-mcp"
  },
  "keywords": ["cyberpunk", "modding", "wolvenkit", "mcp", "redcode", "rednode"],
  "bin": {
    "redcode-mcp": "dist/server.cjs"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
