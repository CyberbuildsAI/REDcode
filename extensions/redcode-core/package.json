{
  "name": "redcode-core",
  "displayName": "REDcode Core",
  "description": "Cyberpunk 2077 modding in VS Code: projects, the game asset browser, and game files as JSON, through REDbridge.",
  "version": "0.2.0",
  "publisher": "cyberbuildsai",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CyberbuildsAI/REDcode",
    "directory": "extensions/redcode-core"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "modding",
    "wolvenkit",
    "redcode"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.cpmodproj"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "redcode",
          "title": "REDcode",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "redcode": [
        {
          "id": "redcode.project",
          "name": "Project"
        },
        {
          "id": "redcode.assets",
          "name": "Game Assets"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "redcode.project",
        "contents": "No REDcode project is open.\nA project is a folder with a WolvenKit .cpmodproj file.\n[New Project](command:redcode.newProject)\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "redcode.assets",
        "contents": "The bridge is not running or no game is loaded.\n[Show bridge log](command:redcode.showLog)\n[Restart bridge](command:redcode.restartBridge)",
        "when": "!redcode.gameLoaded"
      }
    ],
    "commands": [
      {
        "command": "redcode.newProject",
        "title": "New Project",
        "category": "REDcode",
        "icon": "$(new-folder)"
      },
      {
        "command": "redcode.openGameFileAsJson",
        "title": "Open game file as JSON",
        "category": "REDcode"
      },
      {
        "command": "redcode.searchGameFiles",
        "title": "Search game files",
        "category": "REDcode",
        "icon": "$(search)"
      },
      {
        "command": "redcode.addToProject",
        "title": "Add to Project",
        "category": "REDcode",
        "icon": "$(add)"
      },
      {
        "command": "redcode.extractTo",
        "title": "Extract to...",
        "category": "REDcode"
      },
      {
        "command": "redcode.openAssetAsJson",
        "title": "Open as JSON",
        "category": "REDcode"
      },
      {
        "command": "redcode.copyAssetPath",
        "title": "Copy Game Path",
        "category": "REDcode"
      },
      {
        "command": "redcode.openProjectFileAsJson",
        "title": "Open as JSON",
        "category": "REDcode"
      },
      {
        "command": "redcode.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "REDcode"
      },
      {
        "command": "redcode.refreshProject",
        "title": "Refresh Project",
        "category": "REDcode",
        "icon": "$(refresh)"
      },
      {
        "command": "redcode.refreshAssets",
        "title": "Refresh Game Assets",
        "category": "REDcode",
        "icon": "$(refresh)"
      },
      {
        "command": "redcode.restartBridge",
        "title": "Restart bridge",
        "category": "REDcode"
      },
      {
        "command": "redcode.showLog",
        "title": "Show bridge log",
        "category": "REDcode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "redcode.newProject",
          "when": "view == redcode.project",
          "group": "navigation@1"
        },
        {
          "command": "redcode.refreshProject",
          "when": "view == redcode.project",
          "group": "navigation@2"
        },
        {
          "command": "redcode.searchGameFiles",
          "when": "view == redcode.assets",
          "group": "navigation@1"
        },
        {
          "command": "redcode.refreshAssets",
          "when": "view == redcode.assets",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "redcode.addToProject",
          "when": "view == redcode.assets && viewItem =~ /^asset/",
          "group": "inline@1"
        },
        {
          "command": "redcode.addToProject",
          "when": "view == redcode.assets && viewItem =~ /^asset/",
          "group": "1_project@1"
        },
        {
          "command": "redcode.extractTo",
          "when": "view == redcode.assets && viewItem =~ /^asset/",
          "group": "1_project@2"
        },
        {
          "command": "redcode.openAssetAsJson",
          "when": "view == redcode.assets && viewItem == assetFile",
          "group": "2_open@1"
        },
        {
          "command": "redcode.copyAssetPath",
          "when": "view == redcode.assets && viewItem =~ /^asset/",
          "group": "3_copy@1"
        },
        {
          "command": "redcode.openProjectFileAsJson",
          "when": "view == redcode.project && viewItem == projectFile",
          "group": "2_open@1"
        },
        {
          "command": "redcode.revealInExplorer",
          "when": "view == redcode.project && viewItem =~ /^project/",
          "group": "3_reveal@1"
        }
      ],
      "commandPalette": [
        {
          "command": "redcode.addToProject",
          "when": "false"
        },
        {
          "command": "redcode.extractTo",
          "when": "false"
        },
        {
          "command": "redcode.openAssetAsJson",
          "when": "false"
        },
        {
          "command": "redcode.copyAssetPath",
          "when": "false"
        },
        {
          "command": "redcode.openProjectFileAsJson",
          "when": "false"
        },
        {
          "command": "redcode.revealInExplorer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "REDcode",
      "properties": {
        "redcode.gamePath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Cyberpunk 2077",
          "description": "The Cyberpunk 2077 install folder (the one containing bin, archive and r6)."
        },
        "redcode.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Path to REDbridge.exe, or the folder containing it. Empty means the copy bundled with the extension, or REDbridge on PATH."
        },
        "redcode.dotnetRoot": {
          "type": "string",
          "default": "",
          "description": "DOTNET_ROOT for the bridge, when the .NET 10 runtime is installed per user rather than machine wide."
        },
        "redcode.author": {
          "type": "string",
          "default": "",
          "description": "Author name written into new projects."
        }
      }
    },
    "colors": [
      {
        "id": "redcode.folder",
        "description": "Folder icons in the REDcode Project and Game Assets views.",
        "defaults": {
          "dark": "#fcee0a",
          "light": "#8a7a00",
          "highContrast": "#fcee0a",
          "highContrastLight": "#8a7a00"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "vscode-jsonrpc": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "1.70.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
