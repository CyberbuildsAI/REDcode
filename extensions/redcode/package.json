        {
          "command": "redcode.revealInExplorer",
          "when": "view == redcode.project && viewItem =~ /^project/",
          "group": "3_reveal@1"
        },
        {
          "command": "redcode.deleteProjectFile",
          "when": "view == redcode.project && viewItem =~ /^project(File|Folder)/",
          "group": "4_delete@1"
        },
        {
          "command": "redcode.copyTweakPath",
          "when": "view == redcode.tweakdb && viewItem == tweakRecord",
          "group": "inline@1"
        },
        {
          "command": "redcode.newTweakFromRecord",
          "when": "view == redcode.tweakdb && viewItem == tweakRecord && redcode.projectOpen",
          "group": "inline@2"
        },
        {
          "command": "redcode.openTweakRecord",
          "when": "view == redcode.tweakdb && viewItem == tweakRecord",
          "group": "1_open@1"
        },
        {
          "command": "redcode.newTweakFromRecord",
          "when": "view == redcode.tweakdb && viewItem == tweakRecord && redcode.projectOpen",
          "group": "2_tweak@1"
        },
        {
          "command": "redcode.copyTweakPath",
          "when": "view == redcode.tweakdb && viewItem == tweakRecord",
          "group": "3_copy@1"
        },
        {
          "command": "redcode.editInBlender",
          "when": "view == redcode.project && viewItem =~ /^projectFile/ && resourceExtname =~ /^\\.(glb|gltf|mesh)$/",
          "group": "1_modkit@2"
        },
        {
          "command": "redcode.copyLocKey",
          "when": "view == redcode.lockeys && viewItem =~ /^locEntry/",
          "group": "inline@1"
        },
        {
          "command": "redcode.addLocKeyToProject",
          "when": "view == redcode.lockeys && viewItem =~ /^locEntry/ && redcode.projectOpen",
          "group": "inline@2"
        },
        {
          "command": "redcode.copyLocKey",
          "when": "view == redcode.lockeys && viewItem =~ /^locEntry/",
          "group": "1_copy@1"
        },
        {
          "command": "redcode.copyLocText",
          "when": "view == redcode.lockeys && viewItem =~ /^locEntry/",
          "group": "1_copy@2"
        },
        {
          "command": "redcode.addLocKeyToProject",
          "when": "view == redcode.lockeys && viewItem =~ /^locEntry/ && redcode.projectOpen",
          "group": "2_project@1"
        }
      ],
      "commandPalette": [
        {
          "command": "redcode.installHot",
          "when": "redcode.projectOpen && redcode.hotTools"
        },
        {
          "command": "redcode.export",
          "when": "false"
        },
        {
          "command": "redcode.import",
          "when": "false"
        },
        {
          "command": "redcode.extractToProject",
          "when": "false"
        },
        {
          "command": "redcode.addToProject",
          "when": "false"
        },
        {
          "command": "redcode.extractTo",
          "when": "false"
        },
        {
          "command": "redcode.openAssetAsJson",
          "when": "false"
        },
        {
          "command": "redcode.openAssetInEditor",
          "when": "false"
        },
        {
          "command": "redcode.openTexture",
          "when": "false"
        },
        {
          "command": "redcode.copyAssetPath",
          "when": "false"
        },
        {
          "command": "redcode.copyProjectPath",
          "when": "false"
        },
        {
          "command": "redcode.openProjectFileAsJson",
          "when": "false"
        },
        {
          "command": "redcode.openProjectFileInEditor",
          "when": "false"
        },
        {
          "command": "redcode.revealInExplorer",
          "when": "false"
        },
        {
          "command": "redcode.deleteProjectFile",
          "when": "false"
        },
        {
          "command": "redcode.saveJsonToProject",
          "when": "redcode.jsonFromProject"
        },
        {
          "command": "redcode.clearAssetsFilter",
          "when": "redcode.assetsFiltered"
        },
        {
          "command": "redcode.clearProjectFilter",
          "when": "redcode.projectFiltered"
        },
        {
          "command": "redcode.filterProject",
          "when": "redcode.projectOpen"
        },
        {
          "command": "redcode.filterAssets",
          "when": "redcode.gameLoaded"
        },
        {
          "command": "redcode.browseSounds",
          "when": "redcode.gameLoaded"
        },
        {
          "command": "redcode.openProjectFileWith",
          "when": "false"
        },
        {
          "command": "redcode.openTweakRecord",
          "when": "redcode.gameLoaded"
        },
        {
          "command": "redcode.newTweakFromRecord",
          "when": "redcode.gameLoaded && redcode.projectOpen"
        },
        {
          "command": "redcode.copyTweakPath",
          "when": "false"
        },
        {
          "command": "redcode.filterTweakDB",
          "when": "redcode.gameLoaded"
        },
        {
          "command": "redcode.clearTweakDBFilter",
          "when": "redcode.tweakdbFiltered"
        },
        {
          "command": "redcode.packAndTry",
          "when": "redcode.projectOpen"
        },
        {
          "command": "redcode.editInBlender",
          "when": "false"
        },
        {
          "command": "redcode.stopBlender",
          "when": "false"
        },
        {
          "command": "redcode.searchLocKeys",
          "when": "redcode.gameLoaded"
        },
        {
          "command": "redcode.locKeyLanguage",
          "when": "redcode.gameLoaded"
        },
        {
          "command": "redcode.clearLocKeySearch",
          "when": "false"
        },
        {
          "command": "redcode.copyLocKey",
          "when": "false"
        },
        {
          "command": "redcode.copyLocText",
          "when": "false"
        },
        {
          "command": "redcode.addLocKeyToProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "REDcode",
      "properties": {
        "redcode.gamePath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Cyberpunk 2077",
          "description": "The Cyberpunk 2077 install folder (the one containing bin, archive and r6)."
        },
        "redcode.bridgePath": {
          "type": "string",
          "default": "",
          "description": "Path to REDbridge.exe, or the folder containing it. Empty means the copy bundled with the extension, or REDbridge on PATH."
        },
        "redcode.dotnetRoot": {
          "type": "string",
          "default": "",
          "description": "DOTNET_ROOT for the bridge, when the .NET 10 runtime is installed per user rather than machine wide."
        },
        "redcode.author": {
          "type": "string",
          "default": "",
          "description": "Author name written into new projects."
        },
        "redcode.bridgeRepository": {
          "type": "string",
          "default": "Edgemodders/REDbridge",
          "description": "The GitHub repository whose releases Update REDbridge and Install REDbridge download, as owner/name."
        },
        "redcode.bridgeUpdateCheck": {
          "type": "boolean",
          "default": true,
          "description": "When the bridge starts, ask GitHub once per session whether a newer REDbridge release exists and offer to install it. Skipped when the bridge runs from a git checkout."
        },
        "redcode.pack.clean": {
          "type": "boolean",
          "default": true,
          "description": "Empty the project's packed folder before packing, so a file removed from the project does not linger in the mod."
        },
        "redcode.pack.redmod": {
          "type": "boolean",
          "default": false,
          "description": "Pack as a REDmod under packed/mods/<mod name> instead of a plain archive under packed/archive/pc/mod, as WolvenKit's REDmod option does."
        },
        "redcode.export.textureFormat": {
          "type": "string",
          "enum": [
            "png",
            "tga",
            "dds",
            "bmp",
            "jpg",
            "tiff"
          ],
          "default": "png",
          "description": "The image format Export to Raw writes for textures (.xbm), as WolvenKit's XBM export type."
        },
        "redcode.export.meshFormat": {
          "type": "string",
          "enum": [
            "glb",
            "gltf"
          ],
          "enumDescriptions": [
            "One binary file",
            "A .gltf with its .bin beside it"
          ],
          "default": "glb",
          "description": "The glTF form Export to Raw writes for meshes."
        },
        "redcode.export.meshMaterials": {
          "type": "boolean",
          "default": true,
          "description": "Export a mesh's materials and their textures with it, into source/raw, as WolvenKit does by default."
        },
        "redcode.import.keepSettings": {
          "type": "boolean",
          "default": true,
          "description": "Import from Raw keeps the settings of the file it replaces: a texture's group, format, compression and flags, a mesh's materials. WolvenKit's \"Use existing file\"."
        },
        "redcode.launch": {
          "type": "string",
          "enum": [
            "auto",
            "steam",
            "exe"
          ],
          "enumDescriptions": [
            "Through Steam when the game is in a Steam library, else the exe",
            "Always through Steam (steam://rungameid/1091500)",
            "Always bin\\x64\\Cyberpunk2077.exe directly"
          ],
          "default": "auto",
          "description": "How REDcode: Run Game starts the game. A REDmod project (redcode.pack.redmod) adds -modded."
        },
        "redcode.blenderPath": {
          "type": "string",
          "default": "",
          "description": "blender.exe, or the folder it is in, for Edit in Blender. Empty: REDcode looks under Program FilesBlender Foundation (the newest version) and in the Steam libraries."
        },
        "redcode.loc.language": {
          "type": "string",
          "default": "en-us",
          "enum": [
            "en-us",
            "ar-ar",
            "cz-cz",
            "de-de",
            "es-es",
            "es-mx",
            "fr-fr",
            "hu-hu",
            "it-it",
            "jp-jp",
            "kr-kr",
            "pl-pl",
            "pt-br",
            "ru-ru",
            "th-th",
            "tr-tr",
            "ua-ua",
            "zh-cn",
            "zh-tw"
          ],
          "description": "The language of the texts in the LocKeys view and the LocKey hover, and of the onscreens file Add to Project Onscreens writes to."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "redcode",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "pack"
            ],
            "description": "What to run: pack the open project into its packed folder."
          }
        }
      }
    ],
    "colors": [
      {
        "id": "redcode.folder",
        "description": "Folder icons in the REDcode Project and Game Assets views.",
        "defaults": {
          "dark": "#fcee0a",
          "light": "#8a7a00",
          "highContrast": "#fcee0a",
          "highContrastLight": "#8a7a00"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/check-bridge-release.mjs && node esbuild.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "release:check": "node scripts/check-bridge-release.mjs"
  },
  "dependencies": {
    "opus-decoder": "0.7.12",
    "vscode-jsonrpc": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.170.0",
    "@types/vscode": "1.70.0",
    "esbuild": "^0.28.2",
    "three": "0.170.0",
    "typescript": "~5.9.3"
  }
}
