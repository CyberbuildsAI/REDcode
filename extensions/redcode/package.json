{
  "name": "redcode-cyberpunk",
  "displayName": "REDcode for Cyberpunk 2077",
  "description": "REDcode for Visual Studio Code: a Cyberpunk 2077 modding workspace on WolvenKit's engine. Browse the game's archives, edit CR2W files, view textures, meshes and sounds, export, import, pack and install WolvenKit projects.",
  "preview": true,
  "version": "0.9.0",
  "publisher": "edgemodders",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/REDcode",
    "directory": "extensions/redcode"
  },
  "homepage": "https://edgemodders.github.io/REDcode/",
  "bugs": {
    "url": "https://github.com/Edgemodders/REDcode/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "redcode": {
    "minBridgeVersion": "0.8.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk 2077",
    "modding",
    "wolvenkit",
    "cr2w",
    "tweakxl",
    "redmod",
    "redcode"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.cpmodproj"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tweak",
        "aliases": [
          "TweakXL",
          "tweak"
        ],
        "extensions": [
          ".tweak"
        ],
        "configuration": "./language-configuration/tweak.json"
      }
    ],
    "grammars": [
      {
        "language": "tweak",
        "scopeName": "source.tweak",
        "path": "./syntaxes/tweak.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tweak",
        "path": "./snippets/tweak.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "redcode.cr2w",
        "displayName": "REDcode CR2W Editor",
        "selector": [
          {
            "filenamePattern": "*.ent"
          },
          {
            "filenamePattern": "*.app"
          },
          {
            "filenamePattern": "*.mesh"
          },
          {
            "filenamePattern": "*.inkatlas"
          },
          {
            "filenamePattern": "*.mi"
          },
          {
            "filenamePattern": "*.mt"
          },
          {
            "filenamePattern": "*.mlsetup"
          },
          {
            "filenamePattern": "*.mltemplate"
          },
          {
            "filenamePattern": "*.mlmask"
          },
          {
            "filenamePattern": "*.anims"
          },
          {
            "filenamePattern": "*.animgraph"
          },
          {
            "filenamePattern": "*.rig"
          },
          {
            "filenamePattern": "*.morphtarget"
          },
          {
            "filenamePattern": "*.inkwidget"
          },
          {
            "filenamePattern": "*.inkmenu"
          },
          {
            "filenamePattern": "*.inkstyle"
          },
          {
            "filenamePattern": "*.scene"
          },
          {
            "filenamePattern": "*.quest"
          },
          {
            "filenamePattern": "*.questphase"
          },
          {
            "filenamePattern": "*.streamingsector"
          },
          {
            "filenamePattern": "*.streamingblock"
          },
          {
            "filenamePattern": "*.physicalscene"
          },
          {
            "filenamePattern": "*.workspot"
          },
          {
            "filenamePattern": "*.cubemap"
          },
          {
            "filenamePattern": "*.texarray"
          },
          {
            "filenamePattern": "*.envprobe"
          },
          {
            "filenamePattern": "*.es"
          },
          {
            "filenamePattern": "*.gamedef"
          },
          {
            "filenamePattern": "*.lipmap"
          },
          {
            "filenamePattern": "*.fp"
          },
          {
            "filenamePattern": "*.cminimap"
          },
          {
            "filenamePattern": "*.inkanim"
          },
          {
            "filenamePattern": "*.inkfontfamily"
          },
          {
            "filenamePattern": "*.inkcharcustomization"
          },
          {
            "filenamePattern": "*.garmentlayerparams"
          },
          {
            "filenamePattern": "*.behavior"
          },
          {
            "filenamePattern": "*.effect"
          },
          {
            "filenamePattern": "*.particle"
          },
          {
            "filenamePattern": "*.w2mesh"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "redcode.cr2wOption",
        "displayName": "REDcode CR2W Editor",
        "selector": [
          {
            "filenamePattern": "*.xbm"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "redcode.texture",
        "displayName": "REDcode Texture",
        "selector": [
          {
            "filenamePattern": "*.xbm"
          },
          {
            "filenamePattern": "*.tga"
          },
          {
            "filenamePattern": "*.dds"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "redcode.textureOption",
        "displayName": "REDcode Texture",
        "selector": [
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "redcode.mesh",
        "displayName": "REDcode Mesh",
        "selector": [
          {
            "filenamePattern": "*.glb"
          },
          {
            "filenamePattern": "*.gltf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "redcode.audio",
        "displayName": "REDcode Audio",
        "selector": [
          {
            "filenamePattern": "*.wem"
          },
          {
            "filenamePattern": "*.opus"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "redcode.audioOption",
        "displayName": "REDcode Audio",
        "selector": [
          {
            "filenamePattern": "*.wav"
          },
          {
            "filenamePattern": "*.ogg"
          },
          {
            "filenamePattern": "*.oga"
          },
          {
            "filenamePattern": "*.mp3"
          },
          {
            "filenamePattern": "*.flac"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "redcode.sounds",
        "displayName": "REDcode Game Sounds",
        "selector": [
          {
            "filenamePattern": "*.opusinfo"
          }
        ],
        "priority": "default"
      }
