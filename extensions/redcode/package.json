    "viewsWelcome": [
      {
        "view": "redcode.project",
        "contents": "No REDcode project is open.\nA project is a folder with a WolvenKit .cpmodproj file.\n[New Project](command:redcode.newProject)\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "redcode.assets",
        "contents": "The bridge is not running or no game is loaded.\n[Set Game Folder](command:redcode.setGameFolder)\n[Show REDbridge log](command:redcode.showLog)\n[Restart REDbridge](command:redcode.restartBridge)",
        "when": "!redcode.gameLoaded"
      },
      {
        "view": "redcode.tweakdb",
        "contents": "TweakDB is read from the game through REDbridge, which is not running or has no game loaded.\n[Set Game Folder](command:redcode.setGameFolder)\n[Restart REDbridge](command:redcode.restartBridge)",
        "when": "!redcode.gameLoaded"
      },
      {
        "view": "redcode.lockeys",
        "contents": "LocKeys are read from the game through REDbridge, which is not running or has no game loaded.\n[Set Game Folder](command:redcode.setGameFolder)\n[Restart REDbridge](command:redcode.restartBridge)",
        "when": "!redcode.gameLoaded"
      },
      {
        "view": "redcode.lockeys",
        "contents": "Find the text behind a LocKey, or the LocKey for a text: LocKey#123, a secondary key, or words of the text.\n[Search LocKeys](command:redcode.searchLocKeys)",
        "when": "redcode.gameLoaded"
      }
    ],
