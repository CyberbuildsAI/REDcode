    "viewsContainers": {
      "activitybar": [
        {
          "id": "redcode",
          "title": "REDcode",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "redcode": [
        {
          "id": "redcode.project",
          "name": "Project"
        },
        {
          "id": "redcode.assets",
          "name": "Game Assets"
        },
        {
          "id": "redcode.tweakdb",
          "name": "TweakDB"
        },
        {
          "id": "redcode.lockeys",
          "name": "LocKeys"
        },
        {
          "type": "webview",
          "id": "redcode.properties",
          "name": "Properties"
        }
      ]
