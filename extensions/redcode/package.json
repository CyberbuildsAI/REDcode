    "menus": {
      "editor/title": [
        {
          "command": "redcode.saveJsonToProject",
          "when": "redcode.jsonFromProject",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "redcode.saveJsonToProject",
          "when": "redcode.jsonFromProject",
          "group": "1_redcode@1"
        }
      ],
      "view/title": [
        {
          "command": "redcode.pack",
          "when": "view == redcode.project && redcode.projectOpen",
          "group": "navigation@0"
        },
        {
          "command": "redcode.packAndInstall",
          "when": "view == redcode.project && redcode.projectOpen",
          "group": "navigation@0"
